@page "/"
@rendermode InteractiveServer
@using ReviewTool.Core
@using ReviewTool.Web.Services
@implements IAsyncDisposable
@inject TraceWorkspace Workspace
@inject IJSRuntime JS
@inject EditorLauncher Editors

<PageTitle>review-tool</PageTitle>

<div class="app">
    <header class="topbar">
        <button class="brand icon-btn" title="review-tool 기본 화면으로 (대상 추가·비교·보고서 등 열린 창 닫기)" @onclick="GoHome">
            <span class="ico" style="--icon: url('lib/lucide/house.svg')"></span> 홈
        </button>
        <span class="nav-btns" role="group" aria-label="보던 흐름 이동">
            <button title="뒤로: 직전에 보던 진입점·경로 (Alt+←, 마우스 뒤로 단추)" aria-label="뒤로" disabled="@(historyIndex <= 0)" @onclick="() => GoHistory(-1)">←</button>
            <button title="앞으로 (Alt+→)" aria-label="앞으로" disabled="@(historyIndex >= history.Count - 1)" @onclick="() => GoHistory(1)">→</button>
        </span>
        <select value="@target" @onchange="OnTargetChanged" disabled="@(Workspace.RunningTarget is not null)">
            @foreach (var t in Workspace.ListTargets())
            {
                <option value="@t">@t</option>
            }
        </select>
        <button class="icon-btn" title="분석 대상 추가 (폴더 고르기)" @onclick="() => adding = true"
                disabled="@(Workspace.RunningTarget is not null)">
            <span class="ico" style="--icon: url('lib/lucide/plus.svg')"></span> 대상 추가
        </button>
        @if (Workspace.RunningTarget is null)
        {
            <button @onclick="Analyze" disabled="@(target is null || adding)"
                    title="@($"{target} 소스를 다시 읽어 호출 트리를 새로 만듭니다 (코드는 고치지 않음)")">다시 분석</button>
        }
        else
        {
            <button @onclick="Workspace.CancelAnalysis">취소</button>
        }
        @if (Editors.Available.Count > 0)
        {
            <label class="editor-pick" title="코드 스택의 '열기'와 줄 번호를 누르면 이 프로그램으로 파일을 엽니다 (이 도구는 편집하지 않음)">
                코드 열기
                <select value="@editorId" @onchange="OnEditorChanged">
                    @foreach (var ed in Editors.Available)
                    {
                        <option value="@ed.Id">@ed.Name</option>
                    }
                </select>
            </label>
        }
        <span class="views" role="group" aria-label="보기 방식">
            @foreach (var (mode, icon, title) in ViewModes)
            {
                <button class="icon @(viewMode == mode ? "on" : "")" title="@title" aria-label="@title"
                        aria-pressed="@(viewMode == mode ? "true" : "false")" @onclick="() => SetViewMode(mode)">
                    <span class="ico" style="--icon: url('lib/lucide/@(icon).svg')"></span>
                </button>
            }
        </span>
        <span class="status">@Workspace.StatusMessage</span>
        @if (notice is not null)
        {
            <span class="status notice" @onclick="() => notice = null" title="눌러서 닫기">@notice</span>
        }
        @if (Workspace.LastError is not null)
        {
            <span class="error">@Workspace.LastError</span>
        }
        @if (graph is not null)
        {
            <span class="meta">
                @if (freshness is not null)
                {
                    <button class="fresh fresh-@freshness.State.ToString().ToLowerInvariant()" @onclick="() => showFreshness = !showFreshness"
                            title="분석 결과가 지금 코드와 같은지 (30초마다 확인, 분석은 돌리지 않음)">
                        @(freshness.State switch
                        {
                            FreshnessState.Fresh => "● 최신",
                            FreshnessState.Stale => $"● 바뀜 {freshness.Count}",
                            _ => "● 확인 불가",
                        })
                    </button>
                }
                <button class="link icon-btn" title="기준 분석(수정 전)과 지금 분석의 구조 비교" @onclick="ToggleCompare">
                    <span class="ico" style="--icon: url('lib/lucide/git-compare.svg')"></span> 비교
                </button>
                <button class="link icon-btn" title="고른 진입점(또는 전체)을 Markdown 보고서로. 소스 본문·절대 경로 빼기 가능" @onclick="() => showReport = !showReport">
                    <span class="ico" style="--icon: url('lib/lucide/file-text.svg')"></span> 보고서
                </button>
                @graph.AnalyzedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") 분석 ·
                진입점 @graph.EntryPoints.Count · 함수 @graph.Nodes.Count · 호출 @graph.Edges.Count
                @if (graph.Diagnostics.Count > 0)
                {
                    <button class="link warn" @onclick="() => showDiagnostics = !showDiagnostics">못 본 것 @graph.Diagnostics.Count</button>
                }
            </span>
        }
    </header>

    @if (showFreshness && freshness is not null)
    {
        <section class="diagnostics">
            @if (freshness.State == FreshnessState.Fresh)
            {
                <p>분석에 쓴 파일 @(graph?.Inputs.Count)개가 지금과 모두 같습니다.</p>
            }
            else if (freshness.State == FreshnessState.Unknown)
            {
                <p>확인할 수 없습니다: @freshness.Reason 다시 분석하면 확인할 수 있게 됩니다.</p>
            }
            else
            {
                <p>분석 뒤 바뀐 것이 있습니다. 코드 스택의 줄 번호·코드가 지금과 다를 수 있습니다. <b>다시 분석</b>을 누르세요.</p>
                <ul>
                    @if (freshness.ConfigChanged)
                    {
                        <li>대상 설정(targets/@(target).json)이 바뀜</li>
                    }
                    @foreach (var f in freshness.Changed.Take(50))
                    {
                        <li>바뀜: @f</li>
                    }
                    @foreach (var f in freshness.Added.Take(50))
                    {
                        <li>새 파일: @f</li>
                    }
                    @foreach (var f in freshness.Removed.Take(50))
                    {
                        <li>지워짐: @f</li>
                    }
                </ul>
            }
        </section>
    }

    @if (showReport && graph is not null && index is not null && target is not null && !adding)
    {
        <ReportPanel Target="@target" Graph="graph" Index="index" EntryNodeId="@selectedEntry?.NodeId" OnClose="() => showReport = false" />
    }

    @if (showCompare && graph is not null && target is not null)
    {
        <section class="diagnostics compare">
            <div class="compare-bar">
                <b>전후 비교</b>
                <label>기준
                    <select value="@baselineId" @onchange="OnBaselineChanged">
                        @if (snapshots.Count == 0)
                        {
                            <option value="">(기준 없음)</option>
                        }
                        @foreach (var s in snapshots)
                        {
                            <option value="@s.Id">@s.Label</option>
                        }
                    </select>
                </label>
                → 지금 분석(@graph.AnalyzedAt.ToLocalTime().ToString("MM-dd HH:mm"))
                <button class="link icon-btn" title="지금 결과를 비교 기준으로 보관(AI 에게 고치게 하기 전에)" @onclick="SaveBaseline">
                    <span class="ico" style="--icon: url('lib/lucide/history.svg')"></span> 지금 결과를 기준으로 저장
                </button>
                <button class="link close" @onclick="() => showCompare = false">✕ 닫기</button>
            </div>
            @if (snapshots.Count == 0)
            {
                <p>비교할 기준이 없습니다. 고치기 전에 <b>지금 결과를 기준으로 저장</b>을 누르거나, 한 번 더 다시 분석하면 직전 분석이 자동으로 기준이 됩니다.</p>
            }
            else if (comparison is not null)
            {
                @foreach (var w in comparison.ConditionWarnings)
                {
                    <p class="warn-line">⚠ @w</p>
                }
                @if (!comparison.HasChanges)
                {
                    <p>구조 차이가 없습니다.</p>
                }
                <div class="compare-grid">
                    @CompareList("진입점 추가", comparison.EntriesAdded.Select(e => (e, (string?)null)))
                    @CompareList("진입점 삭제", comparison.EntriesRemoved.Select(e => (e, (string?)null)))
                    @CompareList("본문 변경", comparison.BodyChanged.Select(f => ($"{f.Name}  {f.File}:{f.Line}", f.NodeId)))
                    @CompareList("시그니처 변경", comparison.SignatureChanged.Select(p => ($"{p.After.Name}  {p.After.File}:{p.After.Line}", p.After.NodeId)))
                    @CompareList("함수 추가", comparison.FunctionsAdded.Select(f => ($"{f.Name}  {f.File}:{f.Line}", f.NodeId)))
                    @RemovedList(comparison.FunctionsRemoved)
                    @CompareList("이름 변경 후보", comparison.RenameCandidates.Select(p => ($"{p.Before.Name} → {p.After.Name}", p.After.NodeId)))
                    @CompareList("호출 추가", comparison.CallsAdded.Select(c => ($"{c.From} → {c.To}", (string?)null)))
                    @CompareList("호출 삭제", comparison.CallsRemoved.Select(c => ($"{c.From} → {c.To}", (string?)null)))
                </div>
                @if (comparison.BodyChanged.Count > 0 && reviewLog is not null)
                {
                    var changedChecked = comparison.BodyChanged.Count(f => f.NodeId is not null && graph.Nodes.TryGetValue(f.NodeId, out var cn) &&
                                                                           reviewLog.StateOf(cn) == ReviewLog.State.Checked);
                    <p class="review-summary">검토: 본문이 바뀐 함수 @comparison.BodyChanged.Count 개 중 바뀐 뒤 확인 @changedChecked 개</p>
                }
                <p class="hint-line">함수 이름을 누르면 그 함수를 바꿔서 영향받는 진입점을 보여 줍니다. 지워진 함수는 기준 코드로 열립니다.
                    코드 칸에서 기준과 본문이 다른 함수에는 <b>바뀐 줄 보기</b>가 생깁니다. ·
                    @string.Join(" · ", SnapshotComparer.Limits)</p>
            }
            @GitSection()
        </section>
    }

    @if (showDiagnostics && graph is not null)
    {
        <section class="diagnostics">
            <p>분석이 확인하지 못한 것입니다. 비어 있는 호출이 "호출 없음"을 뜻하지 않을 수 있습니다.</p>
            <ul>
                @foreach (var d in graph.Diagnostics)
                {
                    <li>@d</li>
                }
            </ul>
        </section>
    }

    @if (adding || target is null)
    {
        <main class="empty">
            @if (target is null && !adding)
            {
                <p>아직 분석 대상이 없습니다. 분석할 서버 폴더를 고르면 설정을 자동으로 만듭니다.</p>
            }
            else if (target is not null)
            {
                <button class="link back" @onclick="() => adding = false">← 돌아가기</button>
            }
            <TargetSetup OnSaved="OnTargetSaved" OnCancel="() => adding = false" />
        </main>
    }
    else if (graph is null || index is null)
    {
        <main class="empty">
            @if (Workspace.RunningTarget == target)
            {
                <p><b>@target</b> 분석 중입니다. 처음에는 clangd 색인 때문에 몇 분 걸릴 수 있습니다.</p>
            }
            else
            {
                <p><b>@target</b>의 분석 결과가 아직 없습니다. 위의 <b>다시 분석</b>을 누르세요.</p>
            }
            <p class="hint-line">설정 파일: @Workspace.ConfigPath(target)</p>
        </main>
    }
    else
    {
        <main class="panes mode-@LayoutMode">
            <nav class="pane entries">
                <input class="search" placeholder="진입점 찾기 (패킷, 함수)" @bind="entryFilter" @bind:event="oninput" />
                @* 종류 필터: 패킷 / 메시지 / 시작 / 테스트 / 함수. 여러 개 켤 수 있고, 아무것도 안 켜면 전체. 종류가 하나뿐이면 숨긴다. *@
                @{
                    var kindCounts = KindCounts();
                }
                @if (kindCounts.Count > 1)
                {
                    <div class="kind-filter" role="group" aria-label="진입점 종류">
                        @foreach (var (kind, count) in kindCounts)
                        {
                            var k = kind;
                            var on = selectedKinds.Contains(k);
                            <button class="kind @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")" @onclick="() => ToggleKind(k)"
                                    title="@(on ? "이 종류 빼기" : "이 종류만 보기(여러 개 가능)")">
                                @EntryKind.Label(k)<span class="count">@count</span>
                            </button>
                        }
                    </div>
                }
                @* 2단 트리: 폴더(프로젝트) ▸ 클래스 ▸ 진입점. 묶음 이름 "폴더 / 클래스"를 화면에서만 나눈다. *@
                @foreach (var folder in FilteredEntries().GroupBy(e => EntryFolder(e.Group)))
                {
                    var folderKey = folder.Key;
                    var open = IsFolderOpen(folderKey);
                    <button class="group folder" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleFolder(folderKey)"
                            title="@(open ? "접기" : "펼치기")">
                        <span class="caret">@(open ? "▾" : "▸")</span>@folderKey<span class="count">@folder.Count()</span>
                    </button>
                    @if (open)
                    {
                        @foreach (var cls in folder.GroupBy(e => EntryClass(e.Group)))
                        {
                            var classKey = $"{folderKey} / {cls.Key}";
                            var classOpen = cls.Key.Length == 0 || IsClassOpen(classKey);
                            @if (cls.Key.Length > 0)
                            {
                                <button class="group cls" aria-expanded="@(classOpen ? "true" : "false")" @onclick="() => ToggleClass(classKey)"
                                        title="@(classOpen ? "접기" : "펼치기")">
                                    <span class="caret">@(classOpen ? "▾" : "▸")</span>@cls.Key<span class="count">@cls.Count()</span>
                                </button>
                            }
                            @if (!classOpen)
                            {
                                continue;
                            }
                            @foreach (var e in cls)
                            {
                                <button class="entry nested @(selectedEntry == e ? "active" : "")" @onclick="() => SelectEntry(e)"
                                        title="@graph.Nodes[e.NodeId].Name">
                                    <span class="label">@e.Label</span>
                                    @if (reviewLog is { Items.Count: > 0 } && ProgressOf(e.NodeId) is { Checked: > 0 } p)
                                    {
                                        <span class="progress" title="이 진입점에서 닿는 함수 @(p.Total)개 중 확인 @(p.Checked)개">@p.Checked/@p.Total</span>
                                    }
                                    <span class="sub">@ShortName(graph.Nodes[e.NodeId].Name)</span>
                                </button>
                            }
                        }
                    }
                }
                @if (entryFilter.Trim().Length >= 2)
                {
                    // 함수 이름 검색: 누르면 그 함수에 닿는 진입점과 경로(영향 목록)를 열고 첫 경로를 코드 스택으로
                    var found = FoundFunctions();
                    <div class="group">함수 @(found.Count == MaxFoundFunctions ? $"{MaxFoundFunctions}개+" : $"{found.Count}개")</div>
                    @foreach (var fn in found)
                    {
                        var fid = fn.Id;
                        <button class="entry fn-result" title="@fn.Name — 누르면 진입점부터 이 함수까지" @onclick="() => OpenFunction(fid)">
                            <span class="label mono">@ShortName(fn.Name)</span>
                            <span class="sub">@fn.File:@fn.StartLine</span>
                        </button>
                    }
                    @if (found.Count == 0)
                    {
                        <p class="hint-line">이름이 맞는 함수가 없습니다(분석에서 펼친 함수만 찾습니다).</p>
                    }
                }
            </nav>
            <div class="splitter v" data-var="--w-entries" title="끌어서 너비 조절 · 두 번 누르면 기본 크기"></div>

            <section class="pane tree @(viewMode is "graph" or "wide" or "map" or "classes" ? "graph-mode" : "")">
                @if (selectedEntry is null && NeedsEntry)
                {
                    <p class="hint">왼쪽에서 진입점을 고르세요.</p>
                }
                else if (viewMode is "map" or "classes")
                {
                    <SystemMapView Graph="graph" Index="index" Mode="@viewMode" EntryNodeId="@selectedEntry?.NodeId"
                                   OnOpen="OpenFlowPath" OnSelectEntry="SelectEntryFromMap" />
                }
                else if (viewMode == "checks")
                {
                    <div class="view-title">점검 규칙 · <b>@target</b></div>
                    <ChecksView Target="@(target ?? "")" Graph="graph" Index="index" EntryNodeId="@selectedEntry?.NodeId" OnOpen="OpenFinding"
                                OnReloaded="() => flagged.Clear()" />
                }
                else if (viewMode == "journey")
                {
                    <div class="view-title">패킷 여정 · <b>@selectedEntry!.Label</b> <span class="sub">@selectedEntry.Group</span></div>
                    <JourneyView Graph="graph" Index="index" NodeId="@selectedEntry.NodeId" OnOpen="OpenFlowPath" />
                }
                else if (viewMode == "summary")
                {
                    <div class="view-title">흐름 요약 · <b>@selectedEntry!.Label</b> <span class="sub">@selectedEntry.Group</span></div>
                    <FlowSummaryView Graph="graph" Index="index" NodeId="@selectedEntry.NodeId" OnOpen="OpenFlowPath" />
                }
                else if (viewMode != "tree")
                {
                    <div class="tree-tools">
                        <label>깊이
                            <select @bind="graphDepth">
                                <option value="2">2</option>
                                <option value="3">3</option>
                                <option value="4">4</option>
                                <option value="6">6</option>
                                <option value="99">전체</option>
                            </select>
                        </label>
                        <label><input type="checkbox" @bind="showExternal" /> 외부 호출 보기</label>
                        <button class="link" @onclick="FitGraph">화면 맞춤</button>
                        <span class="graph-info">함수 @(graphCount)개@(graphTruncated ? $" (상한 {MaxGraphNodes}개에서 자름)" : "")</span>
                    </div>
                    <div id="graph-canvas" class="graph-canvas"></div>
                    <div class="graph-legend">노드를 누르면 진입점부터 그 함수까지의 코드가 이어 붙습니다 · "N줄" 묶음을 누르면 그 줄(들어갈 함수는 코드 칸 단추로) · 선의 숫자 = 호출 줄 · 노드를 끌면 아래 호출도 같이 · 화면 맞춤 = 처음 배치로 · 점선 테두리 = 깊이 제한으로 더 있음 · 점선 화살표 = 위로 되돌아가는 호출 · 주황 점선 = 등록·메시지 연결(추정)</div>
                }
                else
                {
                    <div class="tree-tools">
                        <label><input type="checkbox" @bind="showExternal" /> 외부 호출(std 등) 보기</label>
                        <button class="link" @onclick="ExpandAll">모두 펼치기</button>
                        <button class="link" @onclick="CollapseAll">접기</button>
                    </div>
                    @if (expandNote is not null)
                    {
                        <div class="note">@expandNote</div>
                    }
                    <div class="tree-body" role="tree" aria-label="호출 트리">
                        @RenderNode([selectedEntry!.NodeId], null)
                    </div>
                }
            </section>
            @if (LayoutMode == "wide")
            {
                <div class="splitter h" data-var="--h-top" title="끌어서 높이 조절 · 두 번 누르면 기본 크기"></div>
            }
            else
            {
                <div class="splitter v" data-var="@(LayoutMode == "graph" ? "--w-graph" : "--w-tree")" title="끌어서 너비 조절 · 두 번 누르면 기본 크기"></div>
            }

            <section class="pane stack">
                @if (impact is not null && graph.Nodes.TryGetValue(impact.TargetId, out var target_))
                {
                    <article class="impact">
                        <div class="frame-head">
                            <span class="ico" style="--icon: url('lib/lucide/radar.svg')"></span>
                            <span class="fname">@target_.Name</span> 을(를) 바꾸면 영향받는 진입점
                            <b>@(impact.Entries.Count)개</b>
                            <span class="loc">(거슬러 올라간 함수 @(impact.CallerCount)개)</span>
                            <button class="link close" @onclick="() => impact = null">✕ 닫기</button>
                        </div>
                        @if (impact.Entries.Count == 0)
                        {
                            <div class="note warn">분석 안에서는 이 함수까지 오는 진입점을 찾지 못했습니다.</div>
                        }
                        <ul class="impact-list">
                            @foreach (var hit in impact.Entries)
                            {
                                var h = hit;
                                <li>
                                    <button class="link" title="이 경로를 코드 스택으로 열기" @onclick="() => OpenImpactPath(h)">
                                        <span class="label">@h.Entry.Label</span>
                                        <span class="sub">@h.Entry.Group</span>
                                    </button>
                                    <span class="path">@string.Join(" → ", h.Path.Select(p => graph.Nodes.TryGetValue(p, out var pn) ? ShortName(pn.Name) : "?"))</span>
                                </li>
                            }
                        </ul>
                        <details class="limits">
                            <summary>이 결과가 증명하지 않는 것</summary>
                            <ul>
                                @foreach (var l in ImpactAnalyzer.Limits)
                                {
                                    <li>@l</li>
                                }
                            </ul>
                        </details>
                    </article>
                }
                @if (removedView is not null && baselineGraph is not null)
                {
                    var removedLines = removedView.Code.Split('\n');
                    var removedColored = CodeColor.Lines(removedLines, baselineGraph.Language);
                    <article class="frame removed">
                        <div class="frame-head">
                            <span class="fname">@removedView.Name</span>
                            <span class="loc">@removedView.File:@removedView.StartLine</span>
                            <span class="badge warn">지워진 함수 · 기준(@BaselineLabel) 코드 · 읽기 전용</span>
                            <button class="link close" @onclick="() => removedView = null">✕ 닫기</button>
                        </div>
                        <div class="code">
                            @for (var r = 0; r < removedLines.Length; r++)
                            {
                                <div class="line"><span class="ln">@(removedView.StartLine + r)</span><span class="src">@ColoredLine(removedColored[r])</span></div>
                            }
                        </div>
                    </article>
                }
                @if (stack.Count > 0)
                {
                    <FlowTools Graph="graph" Path="stack" ChangedFiles="ChangedFiles" />
                }
                @if (stack.Count == 0)
                {
                    <p class="hint">트리에서 함수를 누르면 진입점부터 그 함수까지의 코드가 위에서 아래로 이어 붙습니다.</p>
                }
                @for (var i = 0; i < stack.Count; i++)
                {
                    var frameIndex = i;
                    var node = graph.Nodes[stack[i]];
                    var nextCallLines = i + 1 < stack.Count ? CallLines(stack[i], stack[i + 1]) : new HashSet<int>();
                    <article class="frame" id="frame-@i">
                        <div class="frame-head">
                            <span class="depth">@(i + 1)</span>
                            <span class="fname">@node.Name</span>
                            <span class="loc">@node.File:@node.StartLine</span>
                            @if (node.Kind != NodeKind.External)
                            {
                                var impactId = stack[i];
                                <button class="link icon-btn" title="이 함수를 바꾸면 영향받는 진입점(패킷)" @onclick="() => ShowImpact(impactId)">
                                    <span class="ico" style="--icon: url('lib/lucide/radar.svg')"></span> 영향
                                </button>
                            }
                            @if (node.Kind != NodeKind.External && Editors.Available.Count > 0)
                            {
                                var openFile = node.File;
                                var openLineNo = node.StartLine;
                                <button class="link icon-btn" title="편집기에서 열기" @onclick="() => OpenInEditor(openFile, openLineNo)">
                                    <span class="ico" style="--icon: url('lib/lucide/square-arrow-out-up-right.svg')"></span> 열기
                                </button>
                            }
                            @if (BaselineChange(node) is not null)
                            {
                                var diffId = stack[i];
                                <button class="link icon-btn diff-toggle @(diffOn.Contains(diffId) ? "on" : "")"
                                        title="비교 기준(@BaselineLabel)과 본문이 다릅니다. 누르면 바뀐 줄(빨강 = 지운 줄, 초록 = 더한 줄)"
                                        @onclick="() => ToggleDiff(diffId)">
                                    <span class="ico" style="--icon: url('lib/lucide/git-compare.svg')"></span>
                                    @(diffOn.Contains(diffId) ? "지금 코드" : "바뀐 줄 보기")
                                </button>
                            }
                            @if (i > 0)
                            {
                                var site = CallLines(stack[i - 1], stack[i]).Order().FirstOrDefault();
                                <span class="from">← @graph.Nodes[stack[i - 1]].File:@site 에서 호출</span>
                            }
                            <button class="link close" title="여기까지만 보기" @onclick="() => TruncateStack(frameIndex + 1)">✕ 아래 닫기</button>
                        </div>
                        @if (node.Kind != NodeKind.External && reviewLog is not null)
                        {
                            var rvNode = node;
                            var rvState = reviewLog.StateOf(node);
                            var rvItem = reviewLog.Find(node);
                            <div class="review-row">
                                <button class="rv @(rvState == ReviewLog.State.Checked ? "on" : "")"
                                        title="이 함수를 읽고 확인함(다시 누르면 지움). 본문이 바뀌면 '다시 봐야 함'으로 바뀝니다"
                                        @onclick="() => MarkReview(rvNode, ReviewLog.Mark.Checked)">✓ 확인</button>
                                <button class="rv hold @(rvState == ReviewLog.State.Hold ? "on" : "")"
                                        title="나중에 다시 볼 곳(다시 누르면 지움)" @onclick="() => MarkReview(rvNode, ReviewLog.Mark.Hold)">보류</button>
                                @if (rvState == ReviewLog.State.Stale)
                                {
                                    <span class="badge warn" title="@($"{rvItem?.At.ToLocalTime():MM-dd HH:mm} 에 {(rvItem?.Mark == ReviewLog.Mark.Checked ? "확인" : "보류")} 표시한 뒤 본문이 바뀌었습니다")">다시 봐야 함</span>
                                }
                                @if (rvState != ReviewLog.State.None)
                                {
                                    <input class="rv-note" placeholder="메모 (입력 후 Enter 또는 바깥 클릭)" value="@rvItem?.Note"
                                           @onchange="e => SetReviewNote(rvNode, e.Value?.ToString() ?? string.Empty)" />
                                }
                                else
                                {
                                    <span class="hint-line">읽었으면 확인 · 나중에 볼 곳은 보류</span>
                                }
                            </div>
                        }
                        @if (FileChanged(node.File))
                        {
                            <div class="note warn">이 파일은 분석 뒤 바뀌었습니다. 아래 코드와 줄 번호는 분석 당시 것입니다 — 다시 분석하세요.</div>
                        }
                        @if (node.Kind == NodeKind.External)
                        {
                            <div class="note">분석 범위 밖 함수라 코드가 없습니다.</div>
                        }
                        else if (diffOn.Contains(stack[i]) && BaselineChange(node) is { } beforeNode)
                        {
                            @DiffCode(beforeNode, node)
                        }
                        else
                        {
                            var calls = CallsByLine(stack[i]);
                            <div class="code">
                                @{
                                    var lines = node.Code.Split('\n');
                                    var colored = Colored(node);
                                }
                                @for (var l = 0; l < lines.Length; l++)
                                {
                                    var lineNo = node.StartLine + l;
                                    var hasCalls = calls.TryGetValue(lineNo, out var lineCalls);
                                    var isNext = nextCallLines.Contains(lineNo);
                                    var isOpen = openLine == (frameIndex, lineNo);
                                    var isFlag = flagged.Count > 0 && flagged.Contains((node.File, lineNo));
                                    <div class="line @(hasCalls ? "call" : "") @(isNext ? "next" : "") @(isOpen ? "open" : "") @(isFlag ? "flag" : "")"
                                         title="@(isFlag ? "점검 지적의 근거 줄" : isNext ? "아래 칸으로 이어지는 호출" : null)"
                                         tabindex="@(hasCalls ? "0" : null)" role="@(hasCalls ? "button" : null)"
                                         @onclick="() => ToggleLine(frameIndex, lineNo, hasCalls)"
                                         @onkeydown="e => OnLineKey(e, frameIndex, lineNo, hasCalls)">
                                        <span class="ln" title="편집기에서 이 줄 열기" @onclick="() => OpenInEditor(node.File, lineNo)"
                                              @onclick:stopPropagation="true">@lineNo</span><span class="src">@ColoredLine(colored[l])</span>
                                    </div>
                                    @if (isOpen && lineCalls is not null)
                                    {
                                        <div class="callees">
                                            @foreach (var callee in lineCalls)
                                            {
                                                var cn = graph.Nodes[callee];
                                                var followed = frameIndex + 1 < stack.Count && stack[frameIndex + 1] == callee;
                                                <button class="chip @KindClass(cn) @(followed ? "on" : "")" title="@(followed ? "아래 칸으로 따라 들어간 함수" : null)" @onclick="() => PushFrame(frameIndex, callee)"
                                                        @onclick:stopPropagation="true" disabled="@(cn.Kind == NodeKind.External)">
                                                    @ShortName(cn.Name)
                                                </button>
                                            }
                                        </div>
                                    }
                                }
                                @if (node.CodeTruncated)
                                {
                                    <div class="note">… 길어서 잘림 (@node.File:@node.EndLine 까지)</div>
                                }
                            </div>
                            @if (node.Stop is not null && node.Stop != StopReason.External)
                            {
                                <div class="note">@StopText(node.Stop.Value)</div>
                            }
                            @if (node.Implementations.Count > 0)
                            {
                                <div class="impls">
                                    <span class="badge guess">구현 후보(추정)</span>
                                    @foreach (var impl in node.Implementations)
                                    {
                                        var im = impl;
                                        <button class="link mono" title="편집기에서 열기" @onclick="() => OpenInEditor(im.File, im.Line)">
                                            @im.Name <span class="loc">@im.File:@im.Line</span>
                                        </button>
                                    }
                                </div>
                            }
                        }
                    </article>
                }
            </section>
        </main>
    }
</div>

@code {
    private string? target;
    private TraceGraph? graph;
    private TraceIndex? index;
    private EntryPoint? selectedEntry;
    private string entryFilter = "";
    private bool showExternal;
    private bool showDiagnostics;
    private readonly HashSet<string> expanded = [];
    private List<string> stack = [];
    private (int Frame, int Line)? openLine;

    protected override void OnInitialized()
    {
        target = Workspace.ListTargets().FirstOrDefault();
        Load();
        Workspace.Changed += OnWorkspaceChanged;
        freshnessTimer = new Timer(_ => RefreshFreshness(), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private void OnWorkspaceChanged() => InvokeAsync(() =>
    {
        if (Workspace.RunningTarget is null)
        {
            Load();
        }
        StateHasChanged();
    });

    // ---- 신선도 ----

    private FreshnessReport? freshness;
    private bool showFreshness;
    private Timer? freshnessTimer;

    // 검사는 백그라운드(공유)에서 하고 결과 반영만 화면 스레드에서. 그사이 대상이 바뀌었으면 버린다.
    private void RefreshFreshness()
    {
        var checkTarget = target;
        var checkGraph = graph;
        if (checkTarget is null || checkGraph is null || Workspace.RunningTarget is not null)
        {
            _ = InvokeAsync(() => freshness = null);
            return;
        }
        _ = Workspace.CheckFreshnessAsync(checkTarget).ContinueWith(t => InvokeAsync(() =>
        {
            if (t.IsCompletedSuccessfully && target == checkTarget && ReferenceEquals(graph, checkGraph))
            {
                freshness = t.Result;
                StateHasChanged();
            }
        }), TaskScheduler.Default);
    }

    private bool FileChanged(string relativeFile) => freshness?.IsChanged(relativeFile) == true;

    private IReadOnlyCollection<string>? ChangedFiles => freshness is null ? null : [.. freshness.Changed, .. freshness.Removed];

    public async ValueTask DisposeAsync()
    {
        Workspace.Changed -= OnWorkspaceChanged;
        if (freshnessTimer is not null)
        {
            await freshnessTimer.DisposeAsync();
        }
        if (graphModule is not null)
        {
            try
            {
                await graphModule.InvokeVoidAsync("stopHistoryKeys");
                await graphModule.InvokeVoidAsync("destroy", GraphElementId);
                await graphModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        selfRef?.Dispose();
    }

    // ---- 보기 방식 ----

    private static readonly (string Mode, string Icon, string Title)[] ViewModes =
    [
        ("tree", "list-tree", "트리 보기"),
        ("graph", "network", "노드 보기"),
        ("wide", "layout-panel-top", "노드 크게 (코드는 아래)"),
        ("journey", "route", "패킷 여정 (프로세스를 넘는 흐름)"),
        ("summary", "list-checks", "흐름 요약 (시작 순서, DB·캐시 접근 순서)"),
        ("map", "map", "전체 흐름도 (프로세스 × 클래스)"),
        ("classes", "boxes", "클래스 다이어그램"),
        ("checks", "shield-alert", "점검 규칙 (락 안 I/O, 레인·작업 단위 밖 접근, 차감 뒤 지급, 의존)"),
    ];

    // 칸 배치: 그림이 큰 보기는 위아래(wide), 나머지는 세 칸
    private string LayoutMode => viewMode switch
    {
        "graph" => "graph",
        "wide" or "map" or "classes" => "wide",
        _ => "tree",
    };

    private bool NeedsEntry => viewMode is not ("map" or "classes" or "checks");

    // 여정·요약·지도에서 고른 경로를 코드 스택으로(고른 진입점은 그대로 둔다)
    private void OpenFlowPath(IReadOnlyList<string> path)
    {
        if (graph is null || path.Count == 0 || path.Any(p => !graph.Nodes.ContainsKey(p)))
        {
            return;
        }
        stack = [.. path];
        openLine = null;
        flagged.Clear();
    }

    // 점검 지적: 경로를 코드 스택으로 열고 근거 줄을 표시한다. 경로가 없으면(#include 지적) 편집기로.
    private void OpenFinding(Checks.Finding f)
    {
        if (graph is null)
        {
            return;
        }
        var path = f.Path.Where(graph.Nodes.ContainsKey).ToList();
        // 고른 진입점에서도 닿는 지적이면 그 진입점에서 시작하는 경로로(대표 경로는 가장 가까운 진입점 기준이다)
        if (selectedEntry is not null && index is not null && f.Entries.Contains(selectedEntry.NodeId) && path.FirstOrDefault() != selectedEntry.NodeId &&
            Checks.PathFrom(graph, index, selectedEntry.NodeId, f.NodeId) is { Count: > 0 } head)
        {
            var at = path.IndexOf(f.NodeId);
            path = [.. head, .. at >= 0 ? path.Skip(at + 1) : []];
        }
        if (path.Count == 0)
        {
            OpenInEditor(f.Site.File, f.Site.Line);
            return;
        }
        OpenFlowPath(path);
        flagged.UnionWith(f.Evidence.Select(e => (e.Site.File, e.Site.Line)).Append((f.Site.File, f.Site.Line)));
    }

    // 점검 지적의 근거 줄(파일, 줄). 코드 스택에서 강조한다.
    private readonly HashSet<(string File, int Line)> flagged = [];

    private void SelectEntryFromMap(EntryPoint e)
    {
        SelectEntry(e);
    }

    private const string GraphElementId = "graph-canvas";
    private const int MaxGraphNodes = 250;
    private string viewMode = "tree";
    private int graphDepth = 3;
    private int graphCount;
    private bool graphTruncated;
    private string? renderedGraphKey;
    private bool graphInstanceAlive;
    private string? highlightedKey;
    private IJSObjectReference? graphModule;
    private DotNetObjectReference<Home>? selfRef;
    // 그래프 노드 id(g0, g1 ...) ↔ 분석 노드 id. 분석 id 에는 ':' '@' 가 있어 Cytoscape 선택자에 불편하다.
    private readonly Dictionary<string, string> nodeOfGraphId = [];
    private readonly Dictionary<string, string> graphIdOfNode = [];
    // 너비 우선으로 처음 닿은 부모. 노드를 누르면 이걸 거슬러 진입점까지의 경로를 만든다.
    private readonly Dictionary<string, string> graphParent = [];
    // 같은 줄 묶음: 묶음 그래프 id → (부르는 함수, 줄), 분석 노드 id → 묶음 그래프 id
    private readonly Dictionary<string, (string ParentId, int Line)> graphGroups = [];
    private readonly Dictionary<string, string> graphGroupOf = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            graphModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/graph.js");
            selfRef = DotNetObjectReference.Create(this);
            await graphModule.InvokeVoidAsync("listenHistoryKeys", selfRef);
            var savedEditor = await graphModule.InvokeAsync<string?>("getPref", "editor");
            editorId = Editors.Available.Any(e => e.Id == savedEditor) ? savedEditor! : Editors.Available.FirstOrDefault()?.Id ?? "";
            var saved = await graphModule.InvokeAsync<string?>("getPref", "viewMode");
            if (saved is not null && saved != viewMode && ViewModes.Any(v => v.Mode == saved))
            {
                viewMode = saved;
                StateHasChanged();
                return;
            }
        }
        if (graphModule is null)
        {
            return;
        }

        await TrackNavigationAsync();

        // 줄을 골랐으면(노드 보기 묶음·트리 묶음 머리) 코드 칸을 그 줄로 스크롤
        if (pendingScroll)
        {
            pendingScroll = false;
            await graphModule.InvokeVoidAsync("scrollToSelector", ".pane.stack .line.open");
        }

        // 칸 크기(경계선 끌기): 칸이 새로 그려질 때마다(대상 추가에서 돌아올 때 등) 저장한 크기를 다시 붙인다
        var panesVisible = !adding && target is not null && graph is not null && index is not null;
        if (panesVisible && !splitsApplied)
        {
            await graphModule.InvokeVoidAsync("initSplitters");
            splitsApplied = true;
        }
        else if (!panesVisible)
        {
            splitsApplied = false;
        }

        // 그래프 칸(graph-canvas)이 지금 화면에 있는지. 없으면 JS 쪽 인스턴스를 반드시 정리한다
        // (대상 추가 화면으로 갔다 오면 칸이 새로 만들어지므로 다시 그려야 한다).
        var canvasVisible = !adding && target is not null && viewMode is "graph" or "wide" && selectedEntry is not null &&
                            graph is not null && index is not null;
        if (!canvasVisible)
        {
            if (graphInstanceAlive)
            {
                await graphModule.InvokeVoidAsync("destroy", GraphElementId);
                graphInstanceAlive = false;
            }
            renderedGraphKey = null;
            return;
        }

        var key = $"{graph!.AnalyzedAt:O}|{selectedEntry!.NodeId}|{showExternal}|{graphDepth}|{viewMode}";
        if (key != renderedGraphKey)
        {
            // 매핑(g0, g1 …)은 BuildGraph 가 새로 만든다. 선택 경로는 그 뒤에 계산해야 맞는 노드에 붙는다.
            var (elements, rootId, count, truncated) = BuildGraph();
            var pathIds = GraphPathOfStack();
            var picked = PickedGroup();
            await graphModule.InvokeVoidAsync("render", GraphElementId, elements, rootId, pathIds, selfRef, picked);
            graphInstanceAlive = true;
            renderedGraphKey = key;
            highlightedKey = string.Join(',', pathIds) + "|" + picked;
            if (count != graphCount || truncated != graphTruncated)
            {
                graphCount = count;
                graphTruncated = truncated;
                StateHasChanged();
            }
        }
        else
        {
            var pathIds = GraphPathOfStack();
            var picked = PickedGroup();
            var pathKey = string.Join(',', pathIds) + "|" + picked;
            if (pathKey != highlightedKey)
            {
                await graphModule.InvokeVoidAsync("highlight", GraphElementId, pathIds, picked);
                highlightedKey = pathKey;
            }
        }
    }

    // 코드 칸에서 열어 둔 줄이 노드 보기의 같은 줄 묶음이면 그 묶음 id(묶음 상자를 강조한다)
    private string? PickedGroup()
    {
        if (openLine is not (var frame, var line) || frame >= stack.Count)
        {
            return null;
        }
        var parent = stack[frame];
        return graphGroups.FirstOrDefault(g => g.Value.ParentId == parent && g.Value.Line == line).Key;
    }

    // 함수 본문의 한 줄을 고른다: 진입점 → 그 함수까지 코드 스택을 열고, 그 줄의 호출 단추를 펼친 뒤 그 줄로 스크롤
    private void SelectLineAt(List<string> path, int line)
    {
        SelectPath(path);
        openLine = (path.Count - 1, line);
        pendingScroll = true;
    }

    private bool pendingScroll;

    private void OnGroupHeadKey(KeyboardEventArgs e, List<string> path, int line)
    {
        if (e.Key is "Enter" or " ")
        {
            SelectLineAt(path, line);
        }
    }

    private bool splitsApplied;

    // 기본 화면으로: 대상 추가·패널을 닫는다(고른 진입점과 코드 스택은 그대로)
    private void GoHome()
    {
        adding = false;
        showCompare = false;
        showReport = false;
        showDiagnostics = false;
        showFreshness = false;
        impact = null;
    }

    private async Task SetViewMode(string mode)
    {
        adding = false;   // 대상 추가 화면에서 보기 아이콘을 누르면 그 보기로 돌아간다
        viewMode = mode;
        renderedGraphKey = null;   // 칸 크기가 바뀌므로 다시 배치(인스턴스 정리는 graphInstanceAlive 로 따로 판단)
        if (graphModule is not null)
        {
            await graphModule.InvokeVoidAsync("setPref", "viewMode", mode);
        }
    }

    // 화면 맞춤: 끌어서 옮긴 노드를 처음 배치(소스 순서)로 되돌리고 다시 그린다
    private void FitGraph() => renderedGraphKey = null;

    private (List<object> Elements, string RootId, int Count, bool Truncated) BuildGraph()
    {
        nodeOfGraphId.Clear();
        graphIdOfNode.Clear();
        graphParent.Clear();
        graphGroups.Clear();
        graphGroupOf.Clear();
        var root = selectedEntry!.NodeId;
        var depthOf = new Dictionary<string, int> { [root] = 0 };
        var more = new HashSet<string>();
        var edges = new List<(string From, string To)>();
        var truncated = false;

        var queue = new Queue<string>();
        queue.Enqueue(root);
        while (queue.Count > 0)
        {
            var id = queue.Dequeue();
            var depth = depthOf[id];
            var children = index!.ChildrenOf(id).Where(c => Visible(graph!.Nodes[c.To])).ToList();
            if (depth >= graphDepth)
            {
                if (children.Count > 0)
                {
                    more.Add(id);
                }
                continue;
            }
            foreach (var c in children)
            {
                if (!depthOf.ContainsKey(c.To))
                {
                    if (depthOf.Count >= MaxGraphNodes)
                    {
                        truncated = true;
                        more.Add(id);
                        continue;
                    }
                    depthOf[c.To] = depth + 1;
                    graphParent[c.To] = id;
                    queue.Enqueue(c.To);
                }
                edges.Add((id, c.To));
            }
        }

        // 왼쪽→오른쪽 트리 배치: 열 = 깊이, 형제는 아래로 쌓는다. 공유 노드는 처음 닿은 부모 밑에 한 번만.
        var treeChildren = new Dictionary<string, List<string>>();
        foreach (var (from, to) in edges.Distinct())
        {
            if (graphParent.TryGetValue(to, out var p) && p == from)
            {
                (treeChildren.TryGetValue(from, out var list) ? list : treeChildren[from] = []).Add(to);
            }
        }
        // 같은 줄 묶음: 트리 자식 중 첫 호출 줄이 같은 이웃(둘 이상)을 "N줄" 상자 하나에 넣고 선도 하나만 긋는다
        var groupOf = graphGroupOf;                              // 분석 노드 id → 묶음 그래프 id
        var groupNodes = new List<(string Gid, int Line)>();
        var kidGroups = new Dictionary<string, List<(int? Line, List<string> Members)>>();
        foreach (var (from, kids) in treeChildren)
        {
            var kidEdges = kids.Select(k => index!.ChildrenOf(from).First(e => e.To == k));
            var list = kidGroups[from] = [];
            foreach (var (line, group) in TraceQueries.GroupByLine(kidEdges))
            {
                list.Add((line, group.Select(e => e.To).ToList()));
                if (line is not int ln)
                {
                    continue;
                }
                var gid = "line" + groupNodes.Count;
                groupNodes.Add((gid, ln));
                graphGroups[gid] = (from, ln);
                foreach (var e in group)
                {
                    groupOf[e.To] = gid;
                }
            }
        }

        var columnX = new Dictionary<int, double>();
        var x = 0.0;
        foreach (var d in depthOf.Values.Distinct().Order())
        {
            columnX[d] = x;
            var widest = depthOf.Where(kv => kv.Value == d).Max(kv => ShortName(graph!.Nodes[kv.Key].Name).Length);
            x += widest * 7.5 + 70;
        }
        var position = new Dictionary<string, (double X, double Y)>();
        var nextY = 0.0;
        // fixedY: 같은 줄 묶음의 함수는 묶음 안에서 붙어 있게 자리를 먼저 정하고, 그 아래 호출은 오른쪽 열에서 그 높이부터 놓는다
        double Place(string id, double? fixedY = null)
        {
            var ys = new List<double>();
            if (kidGroups.TryGetValue(id, out var groups))
            {
                if (fixedY is double start)
                {
                    nextY = Math.Max(nextY, start);
                }
                foreach (var (line, members) in groups)
                {
                    if (line is null)
                    {
                        ys.Add(Place(members[0]));
                        continue;
                    }
                    nextY += 18;   // 묶음 상자의 "N줄" 글자 자리
                    var top = nextY;
                    // 묶음 안 간격: 노드 높이(약 34) + 틈 8
                    const double groupRow = 42;
                    for (var i = 0; i < members.Count; i++)
                    {
                        ys.Add(Place(members[i], top + i * groupRow));
                    }
                    nextY = Math.Max(nextY, top + members.Count * groupRow) + 12;
                }
            }
            double y;
            if (fixedY is double fy)
            {
                y = fy;
            }
            else if (ys.Count > 0)
            {
                y = (ys.First() + ys.Last()) / 2;
            }
            else
            {
                y = nextY;
                nextY += 34;
            }
            position[id] = (columnX[depthOf[id]], y);
            return y;
        }
        Place(root);

        var elements = new List<object>();
        foreach (var (gid, line) in groupNodes)
        {
            elements.Add(new { data = new { id = gid, label = $"{line}줄" }, classes = "line-group" });
        }
        foreach (var id in depthOf.Keys)
        {
            var gid = "g" + graphIdOfNode.Count;
            graphIdOfNode[id] = gid;
            nodeOfGraphId[gid] = id;
            var node = graph!.Nodes[id];
            var classes = new List<string>();
            if (id == root) classes.Add("entry");
            if (node.Kind == NodeKind.External) classes.Add("external");
            if (node.Stop == StopReason.Hidden) classes.Add("hidden");
            if (more.Contains(id)) classes.Add("more");
            var (px, py) = position[id];
            var data = new Dictionary<string, object> { ["id"] = gid, ["label"] = ShortName(node.Name) };
            if (groupOf.TryGetValue(id, out var parentGroup))
            {
                data["parent"] = parentGroup;
            }
            // 트리 부모(처음 닿은 부모). 노드를 끌면 이걸로 자식·손자를 같이 옮긴다. 너비 우선 순서라 부모 id 가 먼저 정해져 있다.
            if (graphParent.TryGetValue(id, out var treeParent))
            {
                data["tp"] = graphIdOfNode[treeParent];
            }
            elements.Add(new
            {
                data,
                position = new { x = px, y = py },
                classes = string.Join(' ', classes),
            });
        }
        var emitted = new HashSet<string>();
        foreach (var (from, to) in edges.Distinct())
        {
            var a = graphIdOfNode[from];
            // 트리 자식이 묶음 안에 있으면 선은 묶음 상자로 하나만
            var toGroup = graphParent.TryGetValue(to, out var tp) && tp == from && groupOf.TryGetValue(to, out var g) ? g : null;
            var b = toGroup ?? graphIdOfNode[to];
            if (!emitted.Add($"{a}->{b}"))
            {
                continue;
            }
            var classes = new List<string>();
            if (toGroup is null && depthOf[to] <= depthOf[from])
            {
                classes.Add("back");
            }
            if (index!.ChildrenOf(from).Any(e => (toGroup is null ? e.To == to : groupOf.GetValueOrDefault(e.To) == toGroup) && TraceQueries.IsGuess(e)))
            {
                classes.Add("guess");
            }
            // 선마다 호출 줄 번호: 노드를 끌어 옮겨도 소스 순서를 읽을 수 있게(묶음은 상자에 "N줄"이 있으니 뺌)
            var callLine = toGroup is not null ? null
                : index!.ChildrenOf(from).Where(e => e.To == to).SelectMany(e => e.CallSites).Select(s => (int?)s.Line).Min();
            elements.Add(new { data = new { id = $"{a}->{b}", source = a, target = b, label = callLine?.ToString() ?? "" }, classes = string.Join(' ', classes) });
        }
        return (elements, graphIdOfNode[root], depthOf.Count, truncated);
    }

    // 지금 코드 스택 중 그래프에 그려진 앞부분
    private List<string> GraphPathOfStack()
    {
        var ids = new List<string>();
        foreach (var id in stack)
        {
            if (!graphIdOfNode.TryGetValue(id, out var gid))
            {
                break;
            }
            ids.Add(gid);
        }
        return ids;
    }

    [JSInvokable]
    public Task OnGraphNodeClick(string graphId) => InvokeAsync(() =>
    {
        // 같은 줄 묶음(상자 또는 안의 함수)을 누르면 그 줄을 고른다. 어느 함수로 들어갈지는 코드 칸의 호출 단추로.
        var groupId = graphGroups.ContainsKey(graphId) ? graphId
            : nodeOfGraphId.TryGetValue(graphId, out var member) ? graphGroupOf.GetValueOrDefault(member) : null;
        if (groupId is not null && graphGroups.TryGetValue(groupId, out var g) && graph is not null)
        {
            var parentPath = new List<string> { g.ParentId };
            while (graphParent.TryGetValue(parentPath[^1], out var up))
            {
                parentPath.Add(up);
            }
            parentPath.Reverse();
            SelectLineAt(parentPath, g.Line);
            StateHasChanged();
            return;
        }
        if (!nodeOfGraphId.TryGetValue(graphId, out var id) || graph is null)
        {
            return;
        }
        if (graph.Nodes[id].Kind == NodeKind.External)
        {
            return;
        }
        var path = new List<string> { id };
        while (graphParent.TryGetValue(path[^1], out var parent))
        {
            path.Add(parent);
        }
        path.Reverse();
        SelectPath(path);
        StateHasChanged();
    });

    private void Load()
    {
        var loaded = target is null ? null : Workspace.Get(target);
        var graphChanged = !ReferenceEquals(graph, loaded?.Graph);
        if (graphChanged)
        {
            colorCache.Clear();
            baselineChangeCache.Clear();
            diffCache.Clear();
            // 다른 대상·새 분석이면 이전 그래프로 계산한 결과는 버린다(없는 노드를 가리킬 수 있음)
            impact = null;
            freshness = null;
        }
        graph = loaded?.Graph;
        index = loaded?.Index;
        if (selectedEntry is not null && graph?.EntryPoints.FirstOrDefault(e => e.NodeId == selectedEntry.NodeId) is { } same)
        {
            selectedEntry = same;
            stack = ValidPrefix(same, stack);
            openLine = null;
            flagged.Clear();
        }
        else
        {
            selectedEntry = null;
            stack = [];
            expanded.Clear();
            openLine = null;
            flagged.Clear();
        }
        RefreshFreshness();
        // 다시 분석하면 previous 기준이 새 파일로 바뀌므로 다시 읽는다
        EnsureBaseline(reload: graphChanged);
        ReloadReview();
        if (showCompare)
        {
            RefreshCompare(keepSelection: true);
        }
    }

    private void OnTargetChanged(ChangeEventArgs e)
    {
        target = e.Value?.ToString();
        selectedEntry = null;
        history.Clear();
        historyIndex = -1;
        lastNavKey = null;
        Load();
    }

    // 지금 결과에서도 진입점부터 이어지는 앞부분까지만 남긴다(사라진 함수·끊긴 호출 뒤는 버림)
    private List<string> ValidPrefix(EntryPoint entry, IEnumerable<string> ids)
    {
        var kept = new List<string>();
        foreach (var id in ids)
        {
            if (!graph!.Nodes.ContainsKey(id) || (kept.Count == 0 ? id != entry.NodeId : !index!.ChildrenOf(kept[^1]).Any(e => e.To == id)))
            {
                break;
            }
            kept.Add(id);
        }
        return kept.Count > 0 ? kept : [entry.NodeId];
    }

    // ---- 뒤로/앞으로, 읽던 위치 ----

    private readonly List<(string EntryId, List<string> Stack)> history = [];
    private int historyIndex = -1;
    private bool applyingHistory;
    private string? lastNavKey;
    private string? restoredFor;

    private string? NavKey() => selectedEntry is null ? null : selectedEntry.NodeId + "|" + string.Join(">", stack);

    // 그린 뒤에 위치가 바뀌었으면 기록하고 브라우저에 저장한다(어느 동작으로 바뀌었든 한곳에서)
    private async Task TrackNavigationAsync()
    {
        if (graph is null || index is null || target is null || adding || graphModule is null)
        {
            return;
        }
        if (selectedEntry is null && restoredFor != target)
        {
            restoredFor = target;
            var saved = await graphModule.InvokeAsync<string?>("getPref", "pos:" + target);
            if (saved is not null && RestorePosition(saved))
            {
                StateHasChanged();
                return;
            }
        }
        var key = NavKey();
        if (key is null || key == lastNavKey)
        {
            applyingHistory = false;
            return;
        }
        lastNavKey = key;
        if (!applyingHistory)
        {
            if (historyIndex < history.Count - 1)
            {
                history.RemoveRange(historyIndex + 1, history.Count - historyIndex - 1);
            }
            history.Add((selectedEntry!.NodeId, [.. stack]));
            if (history.Count > 50)
            {
                history.RemoveAt(0);
            }
            historyIndex = history.Count - 1;
            StateHasChanged();   // 뒤로/앞으로 단추 상태
        }
        applyingHistory = false;
        await graphModule.InvokeVoidAsync("setPref", "pos:" + target,
            System.Text.Json.JsonSerializer.Serialize(new SavedPosition(selectedEntry!.NodeId, stack)));
    }

    private sealed record SavedPosition(string E, List<string> S);

    private bool RestorePosition(string json)
    {
        try
        {
            var saved = System.Text.Json.JsonSerializer.Deserialize<SavedPosition>(json);
            var entry = graph!.EntryPoints.FirstOrDefault(e => e.NodeId == saved?.E);
            if (entry is null || saved is null)
            {
                return false;
            }
            selectedEntry = entry;
            expanded.Clear();
            SelectPath(ValidPrefix(entry, saved.S ?? []));
            return true;
        }
        catch (System.Text.Json.JsonException)
        {
            return false;
        }
    }

    private void GoHistory(int delta)
    {
        var i = historyIndex + delta;
        if (graph is null || i < 0 || i >= history.Count)
        {
            return;
        }
        var (entryId, saved) = history[i];
        var entry = graph.EntryPoints.FirstOrDefault(e => e.NodeId == entryId);
        if (entry is null)
        {
            return;
        }
        historyIndex = i;
        applyingHistory = true;
        selectedEntry = entry;
        expanded.Clear();
        impact = null;
        flagged.Clear();
        SelectPath(ValidPrefix(entry, saved));
    }

    [JSInvokable]
    public Task OnHistoryKey(int delta) => InvokeAsync(() =>
    {
        GoHistory(delta);
        StateHasChanged();
    });

    private bool adding;

    // ---- 편집기 열기 ----

    private string editorId = "";

    private async Task OnEditorChanged(ChangeEventArgs e)
    {
        editorId = e.Value?.ToString() ?? "";
        if (graphModule is not null)
        {
            await graphModule.InvokeVoidAsync("setPref", "editor", editorId);
        }
    }

    private void OpenInEditor(string relativeFile, int line)
    {
        if (graph is null)
        {
            return;
        }
        var full = Path.IsPathRooted(relativeFile) ? relativeFile : Path.Combine(graph.RootDirectory, relativeFile);
        notice = Editors.Open(editorId, full, line) ?? $"편집기에서 엶: {relativeFile}:{line}";
    }

    private string? notice;

    // ---- 전후 비교 ----

    private bool showCompare;
    private bool showReport;
    private IReadOnlyList<SnapshotStore.Snapshot> snapshots = [];
    private string baselineId = "";
    private SnapshotComparer.CompareResult? comparison;

    private void ToggleCompare()
    {
        showCompare = !showCompare;
        if (showCompare)
        {
            RefreshCompare(keepSelection: true);
        }
    }

    private void RefreshCompare(bool keepSelection)
    {
        if (target is null)
        {
            return;
        }
        snapshots = Workspace.ListSnapshots(target);
        if (!keepSelection || snapshots.All(s => s.Id != baselineId))
        {
            baselineId = snapshots.FirstOrDefault()?.Id ?? "";
        }
        comparison = baselineId.Length > 0 ? Workspace.Compare(target, baselineId) : null;
        EnsureBaseline();
    }

    private void OnBaselineChanged(ChangeEventArgs e)
    {
        baselineId = e.Value?.ToString() ?? "";
        RefreshCompare(keepSelection: true);
    }

    private void SaveBaseline()
    {
        if (target is null)
        {
            return;
        }
        var saved = Workspace.SaveBaseline(target);
        RefreshCompare(keepSelection: false);
        if (saved is not null)
        {
            baselineId = saved.Id;
            RefreshCompare(keepSelection: true);
            notice = $"기준으로 저장했습니다: {saved.Label}. 코드를 고친 뒤 다시 분석하고 비교하세요.";
        }
    }

    private RenderFragment CompareList(string title, IEnumerable<(string Text, string? NodeId)> items) => __builder =>
