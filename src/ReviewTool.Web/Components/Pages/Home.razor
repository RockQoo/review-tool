    // ---- 검토 기록(7단계 ②) ----

    private ReviewLog? reviewLog;
    private readonly Dictionary<string, (int Checked, int Total)> progressCache = [];

    private (int Checked, int Total) ProgressOf(string entryNodeId)
    {
        if (!progressCache.TryGetValue(entryNodeId, out var p))
        {
            p = progressCache[entryNodeId] = reviewLog!.Progress(graph!, index!, entryNodeId);
        }
        return p;
    }

    private void ReloadReview()
    {
        reviewLog = target is null ? null : Workspace.LoadReview(target);
        progressCache.Clear();
    }

    // 같은 표시를 다시 누르면 지운다(다시 봐야 함 상태에서 누르면 지금 본문으로 다시 표시)
    private void MarkReview(TraceNode node, ReviewLog.Mark mark)
    {
        if (target is null || reviewLog is null)
        {
            return;
        }
        var state = reviewLog.StateOf(node);
        var same = (mark, state) is (ReviewLog.Mark.Checked, ReviewLog.State.Checked) or (ReviewLog.Mark.Hold, ReviewLog.State.Hold);
        reviewLog = Workspace.UpdateReview(target, log => log.Set(node, same ? null : mark));
        progressCache.Clear();
    }

    private void SetReviewNote(TraceNode node, string note)
    {
        if (target is null)
        {
            return;
        }
        reviewLog = Workspace.UpdateReview(target, log => log.SetNote(node, note));
        progressCache.Clear();
    }

    // ---- git 변경 대조(7단계 ④) ----

    private GitChanges.Map? gitMap;
    private string? gitError;
    private bool gitRunning;
    private TraceGraph? gitFor;

    private async Task RunGitAsync()
    {
        if (graph is null || gitRunning)
        {
            return;
        }
        var g = graph;
        gitRunning = true;
        gitError = null;
        StateHasChanged();
        try
        {
            var result = await Task.Run(() => GitChanges.Read(g.RootDirectory));
            if (!ReferenceEquals(g, graph))
            {
                return;   // 그사이 대상·결과가 바뀜
            }
            gitError = result.Error;
            gitMap = result.Error is null ? GitChanges.Build(g, result) : null;
            gitFor = g;
        }
        finally
        {
            gitRunning = false;
        }
    }

    private RenderFragment GitSection() => __builder =>
    {
        var map = ReferenceEquals(gitFor, graph) ? gitMap : null;
        <div class="git-changes">
            <div class="compare-title">
                git 변경 (작업 폴더 vs 마지막 커밋)
                <button class="link" disabled="@gitRunning" @onclick="RunGitAsync">@(gitRunning ? "읽는 중…" : map is null ? "git 변경 보기" : "다시 읽기")</button>
            </div>
            @if (gitError is not null && ReferenceEquals(gitFor, graph))
            {
                <p class="warn-line">⚠ @gitError</p>
            }
            @if (map is not null)
            {
                @if (freshness?.State == FreshnessState.Stale)
                {
                    <p class="warn-line">⚠ 분석 뒤 코드가 바뀌었습니다. 함수 범위는 마지막 분석 기준이라 다시 분석해야 정확합니다.</p>
                }
                <p>바뀐 곳 @(map.Hits.Count + map.Misses.Count) · 흐름에 걸림 @map.Hits.Count · <b>흐름에 안 걸림 @map.Misses.Count</b>@(map.Untracked.Count > 0 ? $" · 새 파일(git 에 없음) {map.Untracked.Count}" : "")</p>
                @if (map.Misses.Count + map.Untracked.Count > 0)
                {
                    <div class="compare-col">
                        <div class="compare-title">흐름에 안 걸린 변경 <span class="count">@(map.Misses.Count + map.Untracked.Count)</span></div>
                        <ul>
                            @foreach (var m in map.Misses.Take(100))
                            {
                                var mf = m.Hunk.File;
                                var ml = m.Hunk.Start;
                                <li><button class="link mono" title="편집기에서 열기" @onclick="() => OpenInEditor(mf, ml)">@m.Hunk.Where</button> <span class="hint-line">@m.Reason</span></li>
                            }
                            @foreach (var u in map.Untracked.Take(50))
                            {
                                var uf = u;
                                <li><button class="link mono" title="편집기에서 열기" @onclick="() => OpenInEditor(uf, 1)">@u</button> <span class="hint-line">git 에 없는 새 파일</span></li>
                            }
                        </ul>
                    </div>
                }
                @if (map.Hits.Count > 0)
                {
                    <div class="compare-col">
                        <div class="compare-title">흐름에 걸린 변경 <span class="count">@map.Hits.Count</span></div>
                        <ul>
                            @foreach (var h in map.Hits.Take(100))
                            {
                                <li>
                                    <span class="mono">@h.Hunk.Where</span> →
                                    @foreach (var id in h.NodeIds.Where(graph!.Nodes.ContainsKey))
                                    {
                                        var fid = id;
                                        <button class="link mono" title="진입점부터 이 함수까지 · 닿는 진입점 목록" @onclick="() => OpenFunction(fid)">@ShortName(graph.Nodes[id].Name)</button>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
                <p class="hint-line">@string.Join(" · ", GitChanges.Limits)</p>
            }
            else if (!gitRunning)
            {
                <p class="hint-line">AI 가 고친 줄이 어느 흐름의 어느 함수에 걸리는지, 어떤 흐름에도 안 걸린 변경(등록 코드·헤더·설정 등)은 무엇인지 봅니다. git 은 읽기만 합니다.</p>
            }
        </div>
    };

    // ---- 흐름 안 전후 비교(7단계 ①) ----

    // 비교 기준 결과(코드 포함). 비교 패널을 열지 않아도 기준이 있으면 코드 칸에서 바뀐 줄을 볼 수 있게 미리 읽는다.
    private TraceGraph? baselineGraph;
    private (string Target, string Id)? baselineFor;
    private readonly HashSet<string> diffOn = [];
    private TraceNode? removedView;

    private string BaselineLabel => snapshots.FirstOrDefault(s => s.Id == baselineId)?.Label ?? "기준";

    private void EnsureBaseline(bool reload = false)
    {
        if (target is null || graph is null)
        {
            baselineGraph = null;
            baselineFor = null;
            return;
        }
        snapshots = Workspace.ListSnapshots(target);
        if (snapshots.All(s => s.Id != baselineId))
        {
            baselineId = snapshots.FirstOrDefault()?.Id ?? "";
        }
        if (!reload && baselineFor == (target, baselineId))
        {
            return;
        }
        baselineFor = (target, baselineId);
        baselineGraph = baselineId.Length > 0 ? Workspace.LoadSnapshot(target, baselineId) : null;
        removedView = null;
        baselineChangeCache.Clear();
        diffCache.Clear();
    }

    // 화면을 다시 그릴 때마다 같은 계산을 하지 않게: 색칠·기준 짝·줄 비교는 결과(그래프·기준)가 바뀔 때만 비운다
    private readonly Dictionary<TraceNode, List<List<CodeColor.Token>>> colorCache = new(ReferenceEqualityComparer.Instance);
    private readonly Dictionary<TraceNode, TraceNode?> baselineChangeCache = new(ReferenceEqualityComparer.Instance);
    private readonly Dictionary<(TraceNode Before, TraceNode After), List<LineDiff.Line>> diffCache = [];

    private List<List<CodeColor.Token>> Colored(TraceNode node)
    {
        if (!colorCache.TryGetValue(node, out var colored))
        {
            colored = colorCache[node] = CodeColor.Lines(node.Code.Split('\n'), graph?.Language ?? "cpp");
        }
        return colored;
    }

    // 이 함수의 기준 쪽 함수(본문이 다를 때만). 같으면·기준이 없으면·확실하지 않으면 null.
    private TraceNode? BaselineChange(TraceNode node)
    {
        if (baselineGraph is null || graph is null || node.Kind == NodeKind.External)
        {
            return null;
        }
        if (!baselineChangeCache.TryGetValue(node, out var before))
        {
            var counterpart = SnapshotComparer.Counterpart(baselineGraph, node);
            before = baselineChangeCache[node] =
                counterpart is not null && SnapshotComparer.BodyChanged(baselineGraph, counterpart, graph, node) ? counterpart : null;
        }
        return before;
    }

    private void ToggleDiff(string id)
    {
        if (!diffOn.Remove(id))
        {
            diffOn.Add(id);
        }
    }

    private RenderFragment DiffCode(TraceNode before, TraceNode after) => __builder =>
    {
        if (!diffCache.TryGetValue((before, after), out var lines))
        {
            lines = diffCache[(before, after)] = LineDiff.Compare(before.Code.Split('\n'), before.StartLine, after.Code.Split('\n'), after.StartLine);
        }
        var (added, removed) = LineDiff.Count(lines);
        <div class="code diff">
            <div class="note">기준(@BaselineLabel) → 지금 · 더한 줄 @added · 지운 줄 @removed · 왼쪽 숫자 = 지금 줄, 흐린 숫자 = 기준 줄 · 읽기 전용(호출 따라가기는 "지금 코드"에서)</div>
            @foreach (var l in lines)
            {
                <div class="line diff-@(l.Op.ToString().ToLowerInvariant())">
                    <span class="ln">@(l.After?.ToString() ?? "")</span><span class="ln old">@(l.Before?.ToString() ?? "")</span><span class="src">@(l.Op switch { LineDiff.Op.Added => "+ ", LineDiff.Op.Removed => "- ", _ => "  " })@l.Text</span>
                </div>
            }
        </div>
    };

    private RenderFragment RemovedList(IReadOnlyList<SnapshotComparer.FunctionRef> removed) => __builder =>
    {
        if (removed.Count == 0)
        {
            return;
        }
        <div class="compare-col">
            <div class="compare-title">함수 삭제 <span class="count">@removed.Count</span></div>
            <ul>
                @foreach (var f in removed.Take(100))
                {
                    var fid = f.NodeId;
                    <li>
                        <button class="link mono" title="기준(수정 전) 코드로 보기"
                                @onclick="() => removedView = fid is not null && baselineGraph is not null ? baselineGraph.Nodes.GetValueOrDefault(fid) : null">
                            @f.Name  @f.File:@f.Line
                        </button>
                    </li>
                }
            </ul>
        </div>
    };

    // ---- 변경 영향 ----

    private ImpactAnalyzer.ImpactResult? impact;

    private void ShowImpact(string nodeId)
    {
        if (graph is not null)
        {
            impact = ImpactAnalyzer.Analyze(graph, nodeId);
        }
    }

    private void OpenImpactPath(ImpactAnalyzer.ImpactedEntry hit)
    {
        if (graph is null || hit.Path.Any(p => !graph.Nodes.ContainsKey(p)))
        {
            impact = null;
            return;
        }
        selectedEntry = hit.Entry;
        expanded.Clear();
        SelectPath([.. hit.Path]);
    }

    private void OnTargetSaved((string Name, bool Analyze) saved)
    {
        adding = false;
        target = saved.Name;
        selectedEntry = null;
        Load();
        if (saved.Analyze)
        {
            Workspace.StartAnalysis(saved.Name);
        }
    }

    private void Analyze()
    {
        if (target is not null)
        {
            Workspace.StartAnalysis(target);
        }
    }

    // ---- 진입점 트리 (폴더 ▸ 클래스 ▸ 진입점) ----

    // 접은 폴더. 기본은 모두 펼침. 검색 중에는 찾은 것이 숨지 않게 모두 펼쳐 보인다.
    private readonly HashSet<string> collapsedFolders = new(StringComparer.Ordinal);

    private static string EntryFolder(string group) => EntryGroup.Folder(group);

    private static string EntryClass(string group) => EntryGroup.Class(group);

    private bool IsFolderOpen(string folder) => entryFilter.Trim().Length > 0 || !collapsedFolders.Contains(folder);

    private void ToggleFolder(string folder)
    {
        if (!collapsedFolders.Remove(folder))
        {
            collapsedFolders.Add(folder);
        }
    }

    // 접은 클래스(열쇠 = 묶음 이름 "폴더 / 클래스"). 기본은 펼침, 검색 중에는 모두 펼침.
    private readonly HashSet<string> collapsedClasses = new(StringComparer.Ordinal);

    private bool IsClassOpen(string classKey) => entryFilter.Trim().Length > 0 || !collapsedClasses.Contains(classKey);

    private void ToggleClass(string classKey)
    {
        if (!collapsedClasses.Remove(classKey))
        {
            collapsedClasses.Add(classKey);
        }
    }

    // ---- 진입점 종류 필터 ----

    // 켠 종류. 지금 대상에 없는 종류가 남아 있어도(대상을 바꾼 뒤) 없는 것은 무시한다.
    private readonly HashSet<string> selectedKinds = new(StringComparer.Ordinal);

    // 진입점별 종류와 종류별 수. 분석 결과(graph)가 바뀔 때만 다시 센다(검색 입력·선택마다 다시 그리므로).
    private TraceGraph? kindsOf_;
    private Dictionary<EntryPoint, string> kindByEntry_ = [];
    private List<(string Kind, int Count)> kindCounts_ = [];

    private void EnsureKinds()
    {
        if (ReferenceEquals(kindsOf_, graph))
        {
            return;
        }
        kindsOf_ = graph;
        kindByEntry_ = graph!.EntryPoints.ToDictionary(e => e, EntryKind.Of); // EntryPoint 는 클래스라 기본이 참조 비교
        var counts = kindByEntry_.Values.GroupBy(k => k).ToDictionary(g => g.Key, g => g.Count());
        kindCounts_ = EntryKind.All.Where(counts.ContainsKey).Select(k => (k, counts[k])).ToList();
    }

    // 지금 대상에 있는 종류와 진입점 수(화면 순서대로)
    private List<(string Kind, int Count)> KindCounts()
    {
        EnsureKinds();
        return kindCounts_;
    }

    private void ToggleKind(string kind)
    {
        if (!selectedKinds.Remove(kind))
        {
            selectedKinds.Add(kind);
        }
    }

    private IEnumerable<EntryPoint> FilteredEntries()
    {
        var q = entryFilter.Trim();
        EnsureKinds();
        var kinds = selectedKinds.Where(k => kindCounts_.Any(c => c.Kind == k)).ToHashSet();
        return graph!.EntryPoints.Where(e => (kinds.Count == 0 || kinds.Contains(kindByEntry_[e])) && (q.Length == 0
            || e.Label.Contains(q, StringComparison.OrdinalIgnoreCase)
            || e.Group.Contains(q, StringComparison.OrdinalIgnoreCase)
            || graph.Nodes[e.NodeId].Name.Contains(q, StringComparison.OrdinalIgnoreCase)));
    }

    // ---- 함수 검색 ----

    private const int MaxFoundFunctions = 20;

    private IReadOnlyList<TraceNode> FoundFunctions() =>
        TraceQueries.FindFunctions(graph!, entryFilter.Trim(), MaxFoundFunctions).Where(n => n.Kind != NodeKind.External).ToList();

    // 함수를 고르면: 닿는 진입점 목록(영향)을 열고, 지금 고른 진입점에서 닿으면 그 경로, 아니면 첫 진입점의 경로를 코드 스택으로
    private void OpenFunction(string id)
    {
        if (graph is null)
        {
            return;
        }
        ShowImpact(id);
        var hits = impact?.Entries ?? [];
        var hit = hits.FirstOrDefault(h => h.Entry.NodeId == selectedEntry?.NodeId) ?? hits.FirstOrDefault();
        if (hit is not null)
        {
            OpenImpactPath(hit);
            notice = hits.Count > 1 ? $"{ShortName(graph.Nodes[id].Name)}: 닿는 진입점 {hits.Count}곳 — 오른쪽 목록에서 다른 경로를 고를 수 있습니다" : null;
        }
        else
        {
            // 닿는 진입점이 없으면 함수 코드만 보여 준다
            stack = [id];
            openLine = null;
            notice = $"{ShortName(graph.Nodes[id].Name)}: 분석 안에서 이 함수에 닿는 진입점을 찾지 못했습니다";
        }
    }

    private void SelectEntry(EntryPoint e)
    {
        selectedEntry = e;
        expanded.Clear();
        expanded.Add(e.NodeId);
        stack = [e.NodeId];
        openLine = null;
        flagged.Clear();
    }

    // ---- 트리 ----

    private static string Key(IReadOnlyList<string> path) => string.Join('>', path);

    private bool Visible(TraceNode n) => showExternal || n.Kind != NodeKind.External;

    private RenderFragment RenderNode(List<string> path, TraceEdge? via) => __builder =>
    {
        var id = path[^1];
        var node = graph!.Nodes[id];
        var key = Key(path);
        var recursive = path.Take(path.Count - 1).Contains(id);
        var children = recursive ? [] : index!.ChildrenOf(id).Where(c => Visible(graph.Nodes[c.To])).ToList();
        var isOpen = expanded.Contains(key);
        var selected = Key(stack) == key;
        <div class="node">
            <div class="row @(selected ? "selected" : "") @KindClass(node)" @onclick="() => SelectPath(path)"
                 tabindex="0" role="treeitem" aria-selected="@(selected ? "true" : "false")"
                 aria-expanded="@(children.Count > 0 ? (isOpen ? "true" : "false") : null)"
                 @onkeydown="e => OnRowKey(e, path, key, children.Count > 0)">
                @if (children.Count > 0)
                {
                    <span class="twisty" aria-hidden="true" @onclick="() => Toggle(key)" @onclick:stopPropagation="true">@(isOpen ? "▾" : "▸")</span>
                }
                else
                {
                    <span class="twisty none"></span>
                }
                <span class="name">@ShortName(node.Name)</span>
                @if (recursive)
                {
                    <span class="badge">↺ 재귀</span>
                }
                @if (node.Stop is StopReason.Hidden)
                {
                    <span class="badge">숨김</span>
                }
                @if (node.Stop is StopReason.DepthLimit or StopReason.NodeLimit)
                {
                    <span class="badge warn">제한</span>
                }
                @if (via is not null && TraceQueries.IsGuess(via))
                {
                    <span class="badge guess" title="@TraceQueries.ResolutionHint(via.Resolution). 소스 텍스트로 추정">@TraceQueries.ResolutionText(via.Resolution)</span>
                }
                @foreach (var tag in node.Tags)
                {
                    <span class="badge tag">@tag</span>
                }
                @if (via is not null)
                {
                    <span class="site">:@string.Join(",", via.CallSites.Select(s => s.Line))</span>
                }
            </div>
            @if (isOpen && children.Count > 0)
            {
                <div class="children">
                    @foreach (var (line, group) in TraceQueries.GroupByLine(children))
                    {
                        @if (line is int ln)
                        {
                            @* 한 문장에서 이어 부른 호출은 한 덩어리로 *@
                            <div class="line-group">
                                <div class="line-group-head" title="이 줄 한 문장에서 부르는 함수 @(group.Count)개 · 누르면 코드에서 이 줄"
                                     tabindex="0" role="button" @onclick="() => SelectLineAt(path, ln)"
                                     @onkeydown="e => OnGroupHeadKey(e, path, ln)">
                                    @(ln)줄 <span class="mono">@LineText(node, ln)</span>
                                </div>
                                @foreach (var c in group)
                                {
                                    @RenderNode([.. path, c.To], c)
                                }
                            </div>
                        }
                        else
                        {
                            @RenderNode([.. path, group[0].To], group[0])
                        }
                    }
                </div>
            }
        </div>
    };

    private void Toggle(string key)
    {
        if (!expanded.Remove(key))
        {
            expanded.Add(key);
        }
    }

    private void SelectPath(List<string> path)
    {
        stack = [.. path];
        openLine = null;
        for (var i = 1; i <= path.Count; i++)
        {
            expanded.Add(Key(path.Take(i).ToList()));
        }
    }

    private void ExpandAll()
    {
        if (selectedEntry is null)
        {
            return;
        }
        // 트리는 "경로" 단위라 공유 함수가 많으면 줄 수가 곱으로 늘어난다. 얕은 쪽부터 펼치고 줄 수 예산에서 멈춘다.
        const int RowBudget = 500;
        var rows = 1;
        expandNote = null;
        var queue = new Queue<List<string>>();
        queue.Enqueue([selectedEntry.NodeId]);
        while (queue.Count > 0)
        {
            var path = queue.Dequeue();
            var children = index!.ChildrenOf(path[^1])
                .Where(c => !path.Contains(c.To) && Visible(graph!.Nodes[c.To])).ToList();
            if (children.Count == 0)
            {
                continue;
            }
            if (rows + children.Count > RowBudget)
            {
                expandNote = $"줄이 너무 많아 {RowBudget}줄에서 멈췄습니다. 필요한 곳은 ▸ 로 더 펼치세요.";
                break;
            }
            expanded.Add(Key(path));
            rows += children.Count;
            foreach (var c in children)
            {
                queue.Enqueue([.. path, c.To]);
            }
        }
    }

    private string? expandNote;

    private void OnLineKey(KeyboardEventArgs e, int frame, int line, bool hasCalls)
    {
        if (e.Key is "Enter" or " ")
        {
            ToggleLine(frame, line, hasCalls);
        }
    }

    private void OnRowKey(KeyboardEventArgs e, List<string> path, string key, bool hasChildren)
    {
        switch (e.Key)
        {
            case "Enter" or " ":
                SelectPath(path);
                break;
            case "ArrowRight" when hasChildren:
                expanded.Add(key);
                break;
            case "ArrowLeft":
                expanded.Remove(key);
                break;
        }
    }

    private void CollapseAll()
    {
        expanded.Clear();
        if (selectedEntry is not null)
        {
            expanded.Add(selectedEntry.NodeId);
        }
    }

    // ---- 코드 스택 ----

    private HashSet<int> CallLines(string from, string to) =>
        index!.ChildrenOf(from).Where(e => e.To == to).SelectMany(e => e.CallSites).Select(s => s.Line).ToHashSet();

    private Dictionary<int, List<string>> CallsByLine(string id)
    {
        var result = new Dictionary<int, List<string>>();
        foreach (var e in index!.ChildrenOf(id))
        {
            if (!Visible(graph!.Nodes[e.To]))
            {
                continue;
            }
            foreach (var s in e.CallSites)
            {
                if (!result.TryGetValue(s.Line, out var list))
                {
                    result[s.Line] = list = [];
                }
                if (!list.Contains(e.To))
                {
                    list.Add(e.To);
                }
            }
        }
        return result;
    }

    private void ToggleLine(int frame, int line, bool hasCalls)
    {
        if (!hasCalls)
        {
            return;
        }
        // 호출이 하나뿐이면 바로 펼친다
        var calls = CallsByLine(stack[frame])[line];
        var internalCalls = calls.Where(c => graph!.Nodes[c].Kind != NodeKind.External).ToList();
        if (internalCalls.Count == 1 && calls.Count == 1)
        {
            PushFrame(frame, internalCalls[0]);
            return;
        }
        openLine = openLine == (frame, line) ? null : (frame, line);
    }

    private void PushFrame(int frame, string callee)
    {
        stack = [.. stack.Take(frame + 1), callee];
        openLine = null;
        SelectPath(stack);
    }

    private void TruncateStack(int count)
    {
        stack = stack.Take(Math.Max(1, count)).ToList();
        openLine = null;
    }

    // ---- 표시 ----

    private static string ShortName(string name) => TraceQueries.ShortName(name);

    // 색칠한 코드 한 줄(글자는 그대로, 종류마다 span)
    private static RenderFragment ColoredLine(List<CodeColor.Token> tokens) => __builder =>
    {
        foreach (var t in tokens)
        {
            if (t.Kind == CodeColor.Kind.Plain)
            {
                @t.Text
            }
            else
            {
                <span class="tk-@(t.Kind.ToString().ToLowerInvariant())">@t.Text</span>
            }
        }
    };

    // 함수 본문의 한 줄(앞뒤 공백 빼고, 길면 줄임)
    private static string LineText(TraceNode node, int line)
    {
        var lines = node.Code.Split('\n');
        var i = line - node.StartLine;
        if (i < 0 || i >= lines.Length)
        {
            return "";
        }
        var text = lines[i].Trim();
        return text.Length > 60 ? text[..57] + "…" : text;
    }

    private static string KindClass(TraceNode n) => n.Kind == NodeKind.External ? "external"
        : n.Stop == StopReason.Hidden ? "hidden" : "";

    private static string StopText(StopReason r) => TraceQueries.StopText(r);
}
